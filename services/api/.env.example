APP_NAME=ResolveAI API
ENVIRONMENT=development
DEBUG=true

# API runtime role (no table ownership, subject to RLS)
DATABASE_URL=postgresql+asyncpg://resolveai_app:resolveai_app@localhost:5432/resolveai
# Owner role, used only by Alembic migrations
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://resolveai:resolveai@localhost:5432/resolveai
# Test database (pytest)
TEST_DATABASE_URL=postgresql+asyncpg://resolveai_app:resolveai_app@localhost:5432/resolveai_test
TEST_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://resolveai:resolveai@localhost:5432/resolveai_test

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]

# Auth. JWT_SECRET is required in production; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS only)
REFRESH_COOKIE_SECURE=false

# Knowledge ingestion. EMBEDDING_PROVIDER=fake needs no key (deterministic vectors, no network).
# OPENAI_API_KEY is required only when EMBEDDING_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(1536) column in document_chunks.
EMBEDDING_DIM=1536
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# Chat model (LLM_PROVIDER=fake needs no key). Nothing calls it yet. LLM_CHAT_MODEL has no
# default on purpose: set it explicitly before enabling drafting.
LLM_PROVIDER=openai
LLM_CHAT_MODEL=
# reasoning_effort for tool-calling requests (agent and drafts). GPT-6 Sol/Luna only accept
# function tools in Chat Completions with "none". Leave empty for models without "none".
LLM_TOOLS_REASONING_EFFORT=none

# Prices in USD per million tokens, used to cost each row in llm_calls.
# Check your provider's current pricing; the embedding default is text-embedding-3-small.
EMBEDDING_PRICE_PER_MTOK=0.02
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0

# Retrieval: fetch the TOP_K nearest chunks, drop any below MIN_SCORE (cosine similarity),
# return the best KEEP. Tune MIN_SCORE with the retrieval evals.
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.30
RETRIEVAL_KEEP=5

# Customer chat widget.
# Dev/demo only: owners can reset conversations and the inbox from Settings. Never in production.
DEMO_TOOLS_ENABLED=false

# WIDGET_DEV_ALLOW_LOCALHOST also allows http://localhost:3000 as the embedding page, for local
# testing (/widget-demo and the settings preview). Never enable it in production.
WIDGET_DEV_ALLOW_LOCALHOST=false
WIDGET_TOKEN_TTL_MINUTES=60
# Messages per minute, per conversation and per client IP; extra messages get 429.
WIDGET_CONVERSATION_RATE_PER_MINUTE=10
WIDGET_IP_RATE_PER_MINUTE=30
# Chat input + output tokens per workspace per UTC day. Above it, the widget answers with the
# fallback message ("Someone from the team can follow up here") instead of calling the LLM.
WIDGET_DAILY_TOKEN_BUDGET=200000

# Message classification. clef = Cloudflare Workers AI @cf/cloudflare/clef-flash, falling back
# to the chat LLM (prompt classify_v1) when Cloudflare isn't configured or a call fails.
# llm = always the chat LLM; fake = deterministic test double.
DECISION_PROVIDER=clef
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# USD per million input tokens (Clef doesn't bill output tokens).
CLEF_FLASH_PRICE_PER_MTOK=0.09
# Below this intent confidence a widget message is answered from the knowledge base.
CLASSIFY_MIN_CONFIDENCE=0.6
# At or above this needs-human probability a widget message becomes a ticket.
NEEDS_HUMAN_THRESHOLD=0.7

# Rate limits (Redis sliding windows). If Redis is down requests are allowed, with a warning
# and the resolveai_rate_limit_redis_errors_total metric. Widget polling is never limited.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_IP_PER_MINUTE=20
# Login and signup attempts per email address (stored hashed).
RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE=10
RATE_LIMIT_SIGNUP_IP_PER_HOUR=30
RATE_LIMIT_REFRESH_IP_PER_MINUTE=60
# Per user.
RATE_LIMIT_UPLOADS_PER_HOUR=60
RATE_LIMIT_REGENERATE_PER_MINUTE=10
# Every authenticated dashboard API request, per user.
RATE_LIMIT_API_USER_PER_MINUTE=300
# Widget messages per workspace (on top of the per-conversation and per-IP limits above), and
# new widget sessions per client IP.
WIDGET_WORKSPACE_RATE_PER_MINUTE=300
WIDGET_SESSION_IP_RATE_PER_MINUTE=20

# Observability. LOG_FORMAT=json (structured, one object per line) or text.
LOG_LEVEL=INFO
LOG_FORMAT=json
# GET /metrics (Prometheus format) requires "Authorization: Bearer <METRICS_TOKEN>".
# Empty disables the endpoint. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
# /health/ready reports the worker "stale" when its heartbeat is older than this (seconds).
WORKER_HEARTBEAT_STALE_S=60
# Optional Sentry error tracking (needs `pip install sentry-sdk`). Empty = off.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Classifier version: prompts classify_<v> (LLM) and classify_criteria_<v> (Clef). Older
# versions stay in the repo; compare them with scripts/run_evals.py --classify-version.
CLASSIFY_VERSION=v3

# Evals (scripts/run_evals.py). A run stops before the next case once its cost reaches the cap.
# EVAL_JUDGE_MODEL empty = LLM_CHAT_MODEL (the judge is costed at the LLM_* prices).
EVAL_MAX_COST_USD=1.00
EVAL_JUDGE_MODEL=
